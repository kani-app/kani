  "query": "SELECT c.upgrade_available, c.chapter_number, c.name AS chapter_name, m.id AS manga_id, COALESCE(m.local_name, m.name) AS manga_title FROM chapters c JOIN manga m ON m.id = c.manga_id WHERE c.upgrade_available IS NOT NULL AND m.deleted_at IS NULL ORDER BY manga_title, c.chapter_number",
