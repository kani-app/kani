  "query": "SELECT m.id, m.name, m.cover_url, m.local_cover_path,\n                      COALESCE(s.name, 'Unknown') AS \"source_name!: String\"\n               FROM manga m\n               LEFT JOIN sources s ON s.id = m.source_id\n               WHERE m.is_orphaned = TRUE\n               ORDER BY m.name",
