package kani:extension;

/// Host-mediated HTTP access for extension requests.
interface http {
    enum method { get, post, put, delete }

    record request {
        method: method,
        url: string,
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
    }

    record response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    send: func(req: request) -> result<response, string>;
}

/// Host-owned HTML documents and element lists referenced by opaque handles.
/// Guests must release every returned document and list handle exactly once.
interface html {
    type doc-handle = s32;
    type list-handle = s32;

    parse: func(html: string) -> result<doc-handle, string>;
    select: func(doc: doc-handle, selector: string) -> result<list-handle, string>;
    attr: func(doc: doc-handle, selector: string, attr: string) -> result<option<string>, string>;
    text: func(doc: doc-handle, selector: string) -> result<option<string>, string>;

    drop-doc: func(handle: doc-handle);
    drop-list: func(handle: list-handle);

    list-len: func(handle: list-handle) -> result<s32, string>;
    list-get: func(handle: list-handle, index: s32) -> result<doc-handle, string>;

    inner-html: func(doc: doc-handle) -> result<option<string>, string>;
    outer-html: func(doc: doc-handle) -> result<option<string>, string>;
    first: func(doc: doc-handle, selector: string) -> result<option<doc-handle>, string>;
    children: func(doc: doc-handle) -> result<list-handle, string>;
}

/// Stateless URL, date, form-encoding, and diagnostic helpers supplied by the host.
interface utility {
    date-parse: func(date: string, fmt: string) -> result<s64, string>;
    date-parse-rfc3339: func(date: string) -> result<s64, string>;
    
    resolve-url: func(base: string, path: string) -> result<string, string>;
    build-url: func(base: string, queries: list<tuple<string, string>>) -> result<string, string>;
    
    url-encode: func(input: string) -> string;
    url-decode: func(input: string) -> result<string, string>;
    
    get-query-param: func(url: string, key: string) -> option<string>;
    
    encode-form: func(data: list<tuple<string, string>>) -> string;
    
    log: func(level: u8, line: u32, message: string);
}

/// Host-owned JSON trees addressed through JSON Pointer paths and opaque handles.
/// Guests must release every root or child handle exactly once.
interface json {
    type json-handle = s32;

    parse: func(data: list<u8>) -> result<json-handle, string>;

    get-str:   func(handle: json-handle, ptr: string) -> result<option<string>, string>;
    get-i64:   func(handle: json-handle, ptr: string) -> result<option<s64>, string>;
    get-f64:   func(handle: json-handle, ptr: string) -> result<option<f64>, string>;
    get-bool:  func(handle: json-handle, ptr: string) -> result<option<bool>, string>;

    array-len: func(handle: json-handle, ptr: string) -> result<option<s32>, string>;
    array-get: func(handle: json-handle, ptr: string, index: s32) -> result<json-handle, string>;

    object-keys: func(handle: json-handle, ptr: string) -> result<list<string>, string>;
    object-get:  func(handle: json-handle, ptr: string, key: string) -> result<option<json-handle>, string>;

    to-string: func(handle: json-handle) -> result<string, string>;
    
    drop-json: func(handle: json-handle);
}

/// Data contracts shared by host imports and the guest provider export.
interface types {
    enum extension-error-kind {
        network,
        parse,
        not-found,
        rate-limited,
        auth,
        content-unavailable,
        timeout,
        invalid-input,
        internal,
        unknown,
        source-updating,
    }

    record extension-error {
        kind: extension-error-kind,
        message: string,
        source-url: option<string>,
        retry-after-secs: option<u32>,
    }

    enum manga-status {
        ongoing,
        completed,
        hiatus,
        cancelled,
        unknown
    }

    record manga-list-item {
        id: string,
        title: string,
        cover-url: option<string>,
    }

    record manga-list {
        manga: list<manga-list-item>,
        has-next-page: bool,
        total-pages: option<u32>,
    }

    record manga-info {
        id: string,
        title: string,
        cover-url: option<string>,
        description: option<string>,
        authors: list<string>,
        artists: list<string>,
        status: manga-status,
        tags: list<string>,
    }

    /// Pages reported by the source listing, when available. This remains distinct from the
    /// downloaded archive count in `chapters.page_count` so re-uploads can be detected.
    record chapter-info {
        id: string,
        number: f64,
        title: option<string>,
        volume: option<s32>,
        scanlator: option<string>,
        date-uploaded: option<s64>,
        language: string,
        page-count: option<u32>,
    }

    record chapter-list {
        chapters: list<chapter-info>,
        has-next-page: bool,
        total-pages: option<u32>,
    }

    /// A single sort option for ordering a list (chapter list or similar).
    record sort-option {
        id: string,
        name: string,
    }

    record page {
        index: s32,
        url: string,
        transform: option<string>,
    }

    record chapter {
        pages: list<page>
    }

    enum filter-type-tag {
        select,
        checkbox,
        text-input,
        sort,
        multiselect,
    }

    enum filter-semantic {
        author,
        artist,
        tag,
    }

    record filter-option {
        filter-name: string,
        name: string,
        value: string,
    }

    record filter-def {
        id: string,
        name: string,
        tag: filter-type-tag,
        options: list<filter-option>,
        default-value: option<filter-state>,
        semantic: option<filter-semantic>,
    }

    record filter-list {
        filters: list<filter-def>,
    }

    record option-state {
        name: string,
        value: string,
    }

    variant filter-state {
        selection(option-state),
        checkbox(bool),
        text-input(string),
        multiselect(list<string>),
    }

    record active-filter {
        filter-name: string,
        state: filter-state,
    }

    /// Flat preference declarations rendered and persisted by the host.
    enum pref-kind {
        /// Boolean stored as "true" or "false".
        toggle,
        /// Single selection from the accompanying options.
        select,
        /// Free-form text.
        text,
        /// JSON array of strings; options may carry metadata such as a placeholder.
        multi-value-list,
    }

    record preference-spec {
        key: string,
        label: string,
        kind: pref-kind,
        // (display-label, stored-value) pairs; only used for select kind
        options: list<tuple<string, string>>,
        // Stringified default: "true"/"false" for toggle, value string for select/text
        default: string,
        description: option<string>,
        // For text kind: render as a password/secret field
        secret: bool,
    }
}

/// Read-only access to the installed extension's host-managed preferences.
interface prefs {
    get-value: func(key: string) -> option<string>;
}

/// Manga source operations implemented by each extension and called by the host.
interface manga-provider {
    use types.{manga-list, manga-info, chapter-list, chapter-info, chapter, preference-spec, filter-list, active-filter, sort-option, extension-error};

    // Returns a JSON-encoded `kani_shared::extension::ExtensionMetadata`. Encoded as a
    // string (rather than a WIT record) so new metadata fields are serde-only additions
    // with no WIT/binding churn.
    get-metadata: func() -> result<string, extension-error>;

    get-popular-manga: func(page: s32, page-size: s32, filters: list<active-filter>) -> result<manga-list, extension-error>;
    search-manga: func(query: string, page: s32, page-size: s32, filters: list<active-filter>) -> result<manga-list, extension-error>;
    get-manga-details: func(manga-id: string) -> result<manga-info, extension-error>;
    get-chapter-list: func(manga-id: string, page: s32, page-size: option<s32>, sort: option<string>) -> result<chapter-list, extension-error>;
    get-chapter-list-stream: async func(manga-id: string, sort: option<string>) -> stream<result<chapter-info, extension-error>>;
    get-pages: func(manga-id: string, chapter-id: string) -> result<chapter, extension-error>;

    get-chapter-sort-list: func() -> result<list<sort-option>, extension-error>;
    get-filter-list: func() -> result<filter-list, extension-error>;
    // Returns a JSON-encoded list of `kani_shared::FilterFetchDef`. Encoded as a
    // string so new fields are serde-only additions with no WIT/binding churn.
    get-fetched-option-sets: func() -> result<string, extension-error>;
    get-preferences: func() -> result<list<preference-spec>, extension-error>;

    get-url: func(manga-id: string) -> result<string, extension-error>;
}

/// Host-side blueprint evaluation that returns an opaque JSON result handle.
interface extraction {
    // Blueprint is passed as postcard-encoded bytes (list<u8>).
    extract-html: func(doc: option<s32>, blueprint: list<u8>) -> result<s32, string>;
    extract-json: func(handle: option<s32>, blueprint: list<u8>) -> result<s32, string>;
    // Like extract-html but the host handles multi-chunk fetching for fixed-page-size sources.
    // Blueprint must include a PaginationConfig; the host injects the offset param per chunk.
    paginated-extract-html: func(page: s32, page-size: s32, blueprint: list<u8>) -> result<s32, string>;
    // Like paginated-extract-html but the request is provided separately so blueprint bytes
    // need not contain a RequestDef (used by the embedded-bytes codegen path).
    paginated-extract-html-raw: func(page: s32, page-size: s32, url: string, method: string, headers: list<tuple<string, string>>, queries: list<tuple<string, string>>, blueprint: list<u8>) -> result<s32, string>;
    // Like paginated-extract-html but for JSON sources.
    paginated-extract-json: func(page: s32, page-size: s32, blueprint: list<u8>) -> result<s32, string>;
    // Like paginated-extract-json but the request is provided separately.
    paginated-extract-json-raw: func(page: s32, page-size: s32, url: string, method: string, headers: list<tuple<string, string>>, queries: list<tuple<string, string>>, blueprint: list<u8>) -> result<s32, string>;
}

/// Host-managed binary cache scoped to the calling extension installation.
interface cache {
    get: func(key: string) -> option<list<u8>>;
    put: func(key: string, value: list<u8>, ttl-secs: u32);
    delete: func(key: string);
    clear: func();
}

/// Host-managed V8 contexts and browser capture operations for script-dependent sources.
interface scripting {
    /// Returns true if a named V8 (Node.js) context is currently live on the host.
    v8-context-exists: func(name: string) -> bool;

    /// Creates a named V8 context by evaluating init-script in a Node.js vm.createContext
    /// sandbox with native Web APIs. Idempotent: if the context already exists returns ok.
    v8-context-create: func(name: string, init-script: string) -> result<_, string>;

    /// Evaluates a JS expression in the named V8 context. Must produce a string value.
    v8-context-eval: func(name: string, script: string) -> result<string, string>;

    /// Drops the named V8 context.
    v8-context-drop: func(name: string);

    /// Loads page-url in the configured solver's cleared browser, runs init-script
    /// before any page JS, and waits for the page's script to call the host-injected
    /// `passPayload(string)` function. Returns the string passed to passPayload.
    /// timeout-ms is the deadline.
    capture-page-payload: func(page-url: string, init-script: string, timeout-ms: u32) -> result<string, string>;
}

/// Extension component boundary: the host supplies capabilities and the guest exports a provider.
world kani-extension {
    import types;
    import http;
    import html;
    import utility;
    import json;
    import prefs;
    import extraction;
    import cache;
    import scripting;
    export manga-provider;
}
